APP_ENV=development
APP_NAME=Explore
APP_KEY=explore
# APP_MODE: all (default) | web | worker
APP_MODE=
APP_PORT=8080
DB_DSN=user:pass@tcp(localhost:3306)/explore?charset=utf8mb4&parseTime=true&loc=UTC&interpolateParams=true
JWT_SECRET=example_secret_key
JWT_ISSUER=mcpx
LOG_FILE=logs/app.log

# Cache (GET reads)
CACHE_TTL_MINUTES=5
CACHE_MAX_ENTRIES=500

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Site defaults (stored in site_settings on first boot)
SITE_NAME=explore
SITE_URL=https://explore.mcpx.in
PRIMARY_COLOR=#38bdf8

# Plans config
PLANS_FILE=config/plans.json

# Gemini (resume analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE=

# Judge (practice submissions)
JUDGE_WORKDIR=
JUDGE_POLL_INTERVAL_MS=1000
# Number of parallel queue consumers started by a worker/all process.
JUDGE_WORKER_CONCURRENCY=1
JUDGE_RECEIPT_PRIVATE_KEY=
JUDGE_RECEIPT_PUBLIC_KEY=
# Optional Docker sandbox runner overrides
# JUDGE_RUNNER: docker (default) | k8s | local (unsandboxed dev fallback)
JUDGE_RUNNER=
# Optional Docker CLI path (default: docker)
JUDGE_DOCKER_BIN=
# Optional global/per-language judge image overrides
JUDGE_DOCKER_IMAGE=
JUDGE_DOCKER_IMAGE_GO=
JUDGE_DOCKER_IMAGE_C=
JUDGE_DOCKER_IMAGE_CPP=
JUDGE_DOCKER_IMAGE_JAVA=
# Optional container resource tuning (defaults: 1 CPU, 64MB tmpfs, 128 pids)
JUDGE_DOCKER_CPUS=
JUDGE_DOCKER_TMPFS_MB=
JUDGE_DOCKER_PIDS_LIMIT=
# Optional compile memory floor in megabytes (default: 512)
JUDGE_DOCKER_COMPILE_MEMORY_MB=
# Optional compile timeout override in milliseconds
JUDGE_DOCKER_COMPILE_TIMEOUT_MS=
# Optional Docker daemon target (example: tcp://127.0.0.1:2375)
DOCKER_HOST=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=
# Optional deploy helper for remote Docker daemon (used by scripts/deploy_gke.sh)
JUDGE_REMOTE_DOCKER_HOST=
JUDGE_REMOTE_DOCKER_TLS_VERIFY=
JUDGE_REMOTE_DOCKER_CERT_PATH=
# Optional automatic provisioning of remote Docker VM from deploy_gke.sh
ENABLE_JUDGE_REMOTE_DOCKER=
FORCE_AUTOPILOT_DIND=
ENABLE_JUDGE_RUNTIME_PREFLIGHT=
JUDGE_RUNTIME_PREFLIGHT_IMAGES=
JUDGE_RUNTIME_PREFLIGHT_SMOKE_IMAGE=
JUDGE_REMOTE_DOCKER_INSTANCE_NAME=
JUDGE_REMOTE_DOCKER_ZONE=
JUDGE_REMOTE_DOCKER_MACHINE_TYPE=
JUDGE_REMOTE_DOCKER_NETWORK=
JUDGE_REMOTE_DOCKER_SUBNET=
JUDGE_REMOTE_DOCKER_PORT=
JUDGE_REMOTE_DOCKER_TAG=
JUDGE_REMOTE_DOCKER_FIREWALL_RULE=
JUDGE_REMOTE_DOCKER_SOURCE_RANGE=
JUDGE_REMOTE_DOCKER_IMAGE_FAMILY=
JUDGE_REMOTE_DOCKER_IMAGE_PROJECT=
JUDGE_REMOTE_DOCKER_PREPULL_IMAGES=
# Optional Kubernetes Job runner overrides (used when JUDGE_RUNNER=k8s)
JUDGE_K8S_IMAGE=
JUDGE_K8S_NAMESPACE=
JUDGE_K8S_SERVICE_ACCOUNT=
JUDGE_K8S_CPU=
JUDGE_K8S_POLL_INTERVAL_MS=
JUDGE_K8S_JOB_TTL_SECONDS=
JUDGE_K8S_KUBECTL_BIN=
JUDGE_K8S_KUBECONFIG=
# onseub desktop app
DESKTOP_FREE_EXPORT_LIMIT=2
DESKTOP_DEVICE_VERIFY_URL=
DESKTOP_SUBSCRIPTION_URL=
ONESUB_EXPLORE_API_BASE_URL=

DESKTOP_DOWNLOAD_MAC_ARM64_URL=https://storage.googleapis.com/YOUR_BUCKET/onesub/1.0.0/OneSub-1.0.0-mac-arm64.dmg
DESKTOP_DOWNLOAD_MAC_X64_URL=https://storage.googleapis.com/YOUR_BUCKET/onesub/1.0.0/OneSub-1.0.0-mac-x64.dmg
DESKTOP_DOWNLOAD_WIN_X64_URL=https://storage.googleapis.com/YOUR_BUCKET/onesub/1.0.0/OneSub-1.0.0-win-x64.exe


# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
