APP_ENV=development
APP_NAME=Explore
APP_KEY=explore
APP_PORT=8080
DB_DSN=user:pass@tcp(localhost:3306)/explore?charset=utf8mb4&parseTime=true&loc=UTC
JWT_SECRET=example_secret_key
JWT_ISSUER=mcpx
LOG_FILE=logs/app.log

# Cache (GET reads)
CACHE_TTL_MINUTES=5
CACHE_MAX_ENTRIES=500

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Site defaults (stored in site_settings on first boot)
SITE_NAME=explore
SITE_URL=https://explore.mcpx.in
PRIMARY_COLOR=#38bdf8

# Plans config
PLANS_FILE=config/plans.json

# Gemini (resume analysis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_API_BASE=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
