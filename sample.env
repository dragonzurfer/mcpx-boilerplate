APP_ENV=development
APP_NAME=Mcpx Boilerplate
APP_KEY=mcpx-boilerplate
APP_PORT=8080
DB_DSN=user:pass@tcp(localhost:3306)/mcpx_boilerplate?charset=utf8mb4&parseTime=true&loc=UTC
JWT_SECRET=example_secret_key
JWT_ISSUER=mcpx
LOG_FILE=logs/app.log
ENABLE_BILLING=true

# API key auth (comma-separated, optional label: key)
API_KEYS=default:change-me
ADMIN_TOKEN=change-me

# IP filtering
IP_ALLOWLIST=
IP_DENYLIST=

# Billing plan config (override the file or provide PLANS_JSON)
PLANS_FILE=config/plans.json

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=12

# Google Play subscriptions (Android)
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PUBSUB_TOKEN=
GOOGLE_PLAY_ENFORCE_ACCOUNT_ID=true
GOOGLE_PLAY_LOG_TOKEN_HASH=false
